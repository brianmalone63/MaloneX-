# MaloneX configuration. Copy to .env for local development.
# NEVER commit a real .env. On Heroku, set these as Config Vars instead.

# development | test | production
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# Bot owner(s). Comma-separated WhatsApp numbers (digits only, with country code)
# or full IDs ending in @s.whatsapp.net or @lid. Owner is set HERE only, never via chat.
OWNER_IDS=254700000000

# 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=replace-with-generated-base64-key

# Required in production. Postgres connection string.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Single non-alphanumeric character that starts a command.
COMMAND_PREFIX=.
