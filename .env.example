# ==== Session (the important one) ====
# Paste the session string you received from your pairing site.
# It is a password for the whole WhatsApp account: never share it,
# never commit it. Leave empty to pair with the built-in page instead.
SESSION=

# Extra owner phone number, digits only with country code (e.g. 254712345678).
# The linked account is always the first owner; this adds one more.
OWNER_PHONE=

# Key that unlocks the built-in pairing page and the admin overview.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ACCESS_KEY=

# Command prefix.
PREFIX=.

# public: strangers may use public commands. private: only owners.
MODE=private

# Your pairing site. Shown as the button on the bot's start page.
PAIRING_SITE_URL=https://brian.pairsite.space

# ==== Ports ====
# Panel servers inject SERVER_PORT, Heroku injects PORT. Locally you can
# set either; the bot binds the first one it finds (default 3000).
SERVER_PORT=3000

# ==== Session format (rarely needed) ====
# Force the expected prefix of the SESSION value, e.g. MaloneX when the
# string looks like "MaloneX~eyJ...".
SESSION_PREFIX=

# ==== Console pairing fallback ====
# A phone number to pair from the server console at boot when no session
# exists yet. The pairing code is printed once to the server log.
PAIR_NUMBER=

# ==== Storage ====
# Postgres is selected automatically when DATABASE_URL starts with postgres://
DATABASE_URL=
DATA_DIR=./data

# ==== Proxy trust ====
# On Heroku the router sets X-Forwarded-For and the bot trusts it by default.
# Set to false on hosts where clients can set that header themselves.
TRUST_PROXY=
