# ================= Core =================

# Storage backend: file (default) or postgres.
# Postgres is selected automatically when DATABASE_URL starts with postgres://
STORAGE=file

# Postgres connection string (Heroku). Leave empty when using file storage.
DATABASE_URL=

# Directory used for file storage and Baileys credentials.
DATA_DIR=./data

# Command prefix. Can be changed at runtime with .setprefix per session.
PREFIX=.

# Owner phone numbers, comma separated, digits only (country code, no +).
# Example: OWNER=254700000001,254700000002
# Extra owners can also be granted at runtime with .setsudo (stored per session).
OWNER=

# Allow non-owner users to run public commands.
# Override at runtime with .setmode public|private.
PUBLIC_MODE=false

# Port for the web pairing server. Panel hosts and Heroku inject PORT
# automatically; the server always binds the dynamic port it is given.
PORT=3000

# ================= Pairing portal =================

# The portal pairs this one session only. Leave as "main" unless you run
# multiple sessions and know what you are doing.
PORTAL_SESSION_ID=main

# Optional password for the portal. When set, the browser asks for the key
# before showing any QR or pairing code (they are session credentials until
# they are consumed). Leave empty for the standard open pairing portal.
PORTAL_PASSWORD=

# Optional key that protects the raw /api/sessions management API (create,
# stop, delete sessions). Send it as "Authorization: Bearer <key>". When
# left empty the management API is disabled entirely.
ADMIN_KEY=

# Log level: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info

# ================= Optional external services =================
# Everything below is optional. Commands that need a service explain how to
# configure it in their reply when the setting is missing. All of these can
# also be set per session through .setsetting (they live in the same schema).

# OpenAI-compatible chat completions endpoint for AI commands and the chatbot.
# Example: AI_API_URL=https://api.openai.com/v1 (any compatible gateway works)
AI_API_URL=
AI_API_KEY=
# Model used by AI commands, e.g. gpt-4o-mini or gemini-1.5-flash.
AI_MODEL=gpt-4o-mini

# Cobalt-compatible media download provider (YouTube, Facebook, Instagram,
# TikTok, Twitter/X). Self-host cobalt for reliability, or leave empty to try
# the public instance. See README "External services".
MEDIA_API_URL=
MEDIA_API_KEY=

# Football data provider (default: free TheSportsDB community tier).
SPORTS_API_URL=
SPORTS_API_KEY=

# Tenor API key for .stickersearch (free at developers.google.com/tenor).
TENOR_API_KEY=

# ImgBB API key for .imgbb uploads (free at api.imgbb.com). .tourl works
# without any key via Catbox.
IMGBB_KEY=

# Image processing provider for .remini and .photoeditor. Must accept
# POST {image_base64, prompt} and reply {image_base64}.
IMG_API_URL=
IMG_API_KEY=
